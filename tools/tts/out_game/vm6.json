{"duration": 24.86, "lines": [{"t": 0.51, "d": 1.0, "text": "Okay."}, {"t": 2.72, "d": 1.1, "text": "I get it."}, {"t": 5.3, "d": 2.79, "text": "You don't want to talk. That's… okay."}, {"t": 9.11, "d": 5.76, "text": "I'm not going to keep calling every day. I can't, Martin. I've got Emily, I've got… a life here."}, {"t": 15.88, "d": 1.99, "text": "But I'm still your brother."}, {"t": 18.79, "d": 1.45, "text": "I'm still here."}, {"t": 21.56, "d": 2.08, "text": "If you ever need me."}]}