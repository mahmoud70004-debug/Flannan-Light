{"duration": 31.68, "call": true, "lines": [{"t": 1.0, "d": 0.78, "who": "MARTIN", "text": "Hello."}, {"t": 2.24, "d": 3.25, "who": "JACK", "text": "Martin, it's Jack. I talked to your old boss today."}, {"t": 6.82, "d": 0.87, "who": "MARTIN", "text": "Okay."}, {"t": 8.57, "d": 4.42, "who": "JACK", "text": "He said you haven't been right since the funeral. Are you still seeing Doctor Hale?"}, {"t": 14.49, "d": 1.05, "who": "MARTIN", "text": "Doctor Hale."}, {"t": 15.93, "d": 1.81, "who": "JACK", "text": "Are you taking the pills?"}, {"t": 19.02, "d": 1.27, "who": "MARTIN", "text": "I'm taking them."}, {"t": 21.35, "d": 1.56, "who": "MARTIN", "text": "I'm taking the pills."}, {"t": 23.44, "d": 2.15, "who": "JACK", "text": "Martin, you sound strange."}, {"t": 27.18, "d": 0.87, "who": "MARTIN", "text": "Do I?"}, {"t": 28.56, "d": 2.13, "who": "JACK", "text": "I love you, man. Call me."}]}