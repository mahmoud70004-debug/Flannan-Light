{"duration": 29.39, "call": true, "lines": [{"t": 0.77, "d": 2.33, "who": "JACK", "text": "Martin? Martin, pick up. Please."}, {"t": 4.24, "d": 0.94, "who": "MARTIN", "text": "I'm here."}, {"t": 6.1, "d": 4.97, "who": "JACK", "text": "I can't get off work till after the holidays. I'm sorry. I'll come as soon as I can."}, {"t": 12.62, "d": 1.12, "who": "MARTIN", "text": "It's all right."}, {"t": 15.14, "d": 1.36, "who": "MARTIN", "text": "Nobody has come."}, {"t": 16.95, "d": 1.35, "who": "JACK", "text": "What? What do you mean?"}, {"t": 20.16, "d": 1.94, "who": "MARTIN", "text": "There's someone else on the line."}, {"t": 22.6, "d": 3.37, "who": "JACK", "text": "Martin, it's just me. Stay on the phone with me, okay?"}, {"t": 27.93, "d": 1.16, "who": "MARTIN", "text": "He's listening."}]}